# Clerk (autenticación) — https://dashboard.clerk.com -> tu app -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps — https://console.cloud.google.com/google/maps-apis
# Habilitar: Maps JavaScript API + Places API. Restringir por HTTP referrer (localhost:5173).
VITE_GOOGLE_MAPS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública del backend. Dejar VACÍO en desarrollo: el proxy de Vite
# redirige /api al backend local. En producción (Vercel) debe apuntar al
# backend desplegado, por ejemplo: https://urbanlog-api.onrender.com
VITE_API_URL=
