# ─── Servidor ─────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── MongoDB Atlas ────────────────────────────────────────────────────────
# Creá un cluster gratuito en https://cloud.mongodb.com y pegá acá la connection string
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/urbanlog

# ─── Clerk (autenticación) ────────────────────────────────────────────────
# https://dashboard.clerk.com -> tu app -> API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Anthropic (IA) ───────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cloudinary (imágenes) ────────────────────────────────────────────────
# https://console.cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=xxxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxx

# ─── Resend (email) ───────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=UrbanLog <onboarding@resend.dev>

# ─── Scope público de la API (consumo externo, ej. PowerBI) ──────────────
# Generá cualquier string largo y random propio, ej: openssl rand -hex 32
PUBLIC_API_KEY=cambiar-por-una-clave-larga-y-random
